package com.moto.service.servicios;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.carro.service.entidades.Carro;
import com.moto.service.entidades.Moto;
import com.moto.service.repositorio.MotoRepository;

@Service
public class MotoService {
	
	@Autowired
	public MotoRepository motoRepository;
	
	public List<Moto> getAll(){
		return motoRepository.findAll();
	}
	
	public Moto getCarroById(int id) {
		return motoRepository.findById(id).orElse(null);
	}
	
	public Moto save(Moto carro) {
		Moto nuevoUsuario = motoRepository.save(carro);
		return nuevoUsuario;
	}
	
	public List<Moto> byUsuarioId(int usuarioId){
		return motoRepository.findByUsuarioId(usuarioId);
	}

}
